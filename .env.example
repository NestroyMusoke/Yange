# Copy to .env only for local Google-adapter development. Never commit .env,
# service-account JSON, access tokens, or secret values. Normal local mode needs
# none of these values.
YANGE_RUNTIME=local
YANGE_ROLE=all
YANGE_ALLOWED_ORIGIN=http://127.0.0.1:4173
YANGE_SESSION_SECRET=

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MULTIMODAL_MODEL=gemini-3.5-flash-lite
FIRESTORE_DATABASE=(default)
YANGE_MEDIA_BUCKET=
YANGE_TASK_LOCATION=me-central1
YANGE_WEARCAST_QUEUE=wearcast-runs
YANGE_EVENTS_TOPIC=yange-domain-events
YANGE_WORKER_URL=
YANGE_TASK_INVOKER_SERVICE_ACCOUNT=
YANGE_WEATHER_LATITUDE=0.3476
YANGE_WEATHER_LONGITUDE=32.5825
GOOGLE_CALENDAR_ID=
YANGE_MIRROR_ENABLED=false
YANGE_MIRROR_LOCATION=europe-west1
YANGE_MIRROR_QUEUE=mirror-previews
YANGE_MIRROR_DAILY_LIMIT=4
VITE_YANGE_API_BASE_URL=http://127.0.0.1:8080
